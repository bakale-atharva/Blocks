# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local agent tooling (installed skills and hooks; reinstall from skills-lock.json).
/.agents/
/.codex/
# Platform-specific skill binaries.
/.claude/skills/*/scripts/bin/

# Graphify output is local only; regenerate with the commands in docs/SETUP.md.
/graphify-out/
